target/

# CycloneDX SBOMs: on-demand only, never tracked (auto-generated locally)
*.cdx.json
*.cdx.xml

# Generated code
crates/hdds/src/generated/
sdk/samples/**/generated/

# Python bytecode
__pycache__/
*.pyc
*.pyo

# Compiled binaries (C/C++ samples)
sdk/samples/**/build/
crates/hdds-c/examples/basic_pubsub

# Local cargo config (cross-compilation paths are machine-specific)
# Copy .cargo/config.toml.example to .cargo/config.toml and adjust paths
.cargo/config.toml

# IDE / tool caches
.devit/
.screenshot/

# CI/CD (non-GitHub)
.gitea/
.forgejo/

# Test artifacts
archives/
fuzz/logs/

# Maintainer-only tooling, not distributed
maintainer/*
/maintainer


# Backup / disabled files
*.backup
*.disabled

# Non-public examples
crates/hdds/examples/*_hack.rs

# Vendor-specific configs
configs/rti*

# Editor files
*.swp

# Misc
/SHA256SUMS
/target/release-validation/

# Build outputs
/build/
rmw_hdds/build/
rmw_hdds/install/
rmw_hdds/log/
rmw_hdds/ROS2_SETUP.md
rmw_hdds/bench_results/
sdk/cxx/build/
sdk/typescript/node_modules/
sdk/typescript/dist/
sdk/typescript/dist-samples/
sdk/typescript/*.tgz
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
compile_commands.json
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe
sbom/SHA256SUMS

# Python SDK build artefacts (the gate builds the wheel from a copy under the
# cargo target dir; these only appear after an in-place pip/setuptools run)
sdk/python/dist/
sdk/python/build/
sdk/python/*.egg-info/
sdk/python/.venv/

# Per-worktree cargo target dirs (CARGO_TARGET_DIR=<worktree>/target-<name>)
/target-*/

# Sanitizer cargo target dirs. scripts/tsan-test.sh defaults to .target-tsan/
# so instrumented artifacts never pollute the normal build cache -- but the
# leading dot means /target-*/ above does not cover it, and a contributor who
# ran the script saw thousands of untracked build files.
/.target-*/

# Fuzzing corpora are generated inputs, not sources.
tools/hdds-gen/fuzz/corpus/
