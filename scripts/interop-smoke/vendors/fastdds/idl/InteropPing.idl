// InteropPing.idl
//
// Canonical keyed type for the HDDS cross-vendor interop smoke test
// (scripts/interop-smoke/). Compiled as-is by each vendor's own IDL
// compiler (IDL4 @key annotation: cyclonedds idlc, fastddsgen, opendds_idl
// --idl-version 4 all accept this syntax). Do not edit per-vendor copies
// to diverge from this layout: the wire format must stay identical across
// all peers for the matrix to compare apples to apples.
//
// This is a verbatim copy of scripts/interop-smoke/idl/InteropPing.idl,
// needed here because the Docker build context for this vendor is
// restricted to this subdirectory. Keep it in sync with the canonical copy.

@final
struct InteropPing {
    @key long key;
    unsigned long seq;
    octet payload[32];
};
